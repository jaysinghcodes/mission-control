# Mission Control API — env template.
# Copy to .env and fill in real values. Never commit .env.

# Postgres connection (Prisma 7 reads this at runtime; production refuses to boot without it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# HTTP + WS port and bind host (loopback default — do not expose without intent)
PORT=3000
HOST=127.0.0.1

# Allowed dashboard origin (CORS at both HTTP and WS layers; never wildcard)
WEB_ORIGIN=http://localhost:5173

# WebSocket handshake token — REQUIRED in production (fail-closed)
SOCKET_TOKEN=change-me

# Ingest token for POST /events producers (OpenClaw bridge) — REQUIRED in production
INGEST_TOKEN=change-me

# health.tick broadcast interval in ms; 0 disables
HEALTH_TICK_MS=30000
