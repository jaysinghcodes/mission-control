// Mission Control — Prisma schema (v1: foundation only).
//
// SECURITY (vibe-dev-workflow red line): database schema is a never-vibe
// domain. This is the initial structural proposal; migrations and any column
// changes get human review before landing on main.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (see file next to schema).
datasource db {
  provider = "postgresql"
}

/// Scheduled runs / jobs observed by the dashboard (Morning Brief, Trend Radar, ...).
model Run {
  id        String   @id @default(cuid())
  name      String // e.g. "Trend Radar"
  status    String   @default("queued") // queued | running | done | failed
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
}

/// Agent roster — color-coded in the UI (Henry, Ralph, Scout, Echo).
model Agent {
  id    String @id @default(cuid())
  name  String @unique
  color String // matches design tokens: purple | amber | green | teal
}
