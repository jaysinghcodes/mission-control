#!/bin/bash
set -euo pipefail
INGEST_TOKEN=$(grep '^INGEST_TOKEN=' /home/ubuntu/.openclaw/workspace/projects/mission-control/apps/api/.env | cut -d= -f2)
API=http://127.0.0.1:3000

post() {
  local type="$1" payload="$2"
  curl -s -X POST "$API/events" -H 'content-type: application/json' -H "x-ingest-token: $INGEST_TOKEN" \
    -d "$(python3 -c 'import json,sys; print(json.dumps({"type": sys.argv[1], "payload": json.loads(sys.argv[2])}))' "$type" "$payload")"
  echo " <- $type"
}

